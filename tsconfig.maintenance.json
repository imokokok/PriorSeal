{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.mts",
    "sdk/scripts/**/*.mts",
    "examples/**/*.mts",
    "test/**/*.mts",
    "worker-configuration.d.ts"
  ]
}
