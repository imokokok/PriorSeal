{
  "name": "priorseal",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Independently verifiable on-chain execution evidence for agents.",
  "homepage": "https://priorseal.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imokokok/PriorSeal.git"
  },
  "bugs": {
    "url": "https://github.com/imokokok/PriorSeal/issues"
  },
  "type": "module",
  "scripts": {
    "example:receipt": "node examples/create-signed-receipt.mjs",
    "verify:receipt": "node examples/verify-signed-receipt.mjs",
    "sdk:build": "npm --prefix sdk run build",
    "test": "npm run sdk:build && node --test test/**/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "test:coverage": "npm run sdk:build && c8 --all --include='src/**/*.mjs' --reporter=text --check-coverage --lines 75 --functions 70 --branches 65 --statements 75 node --test test/**/*.test.mjs",
    "lint": "node scripts/quality.mjs lint",
    "format:check": "node scripts/quality.mjs format",
    "typecheck": "node scripts/quality.mjs typecheck",
    "build": "npm run sdk:build && npm --prefix web run build",
    "preview:web": "node scripts/preview-web.mjs",
    "check:web-performance": "node scripts/check-web-performance.mjs",
    "contracts:check": "node scripts/compile-contracts.mjs",
    "contracts:build": "node scripts/compile-contracts.mjs --write",
    "anchor:prepare": "node --env-file=.env.local scripts/prepare-transparency-anchor.mjs",
    "anchor:record": "node --env-file=.env.local scripts/record-transparency-anchor.mjs",
    "production:check": "node --env-file=.env.local scripts/production-readiness.mjs",
    "production:smoke": "node scripts/production-smoke.mjs",
    "production:smoke:pending": "node scripts/production-smoke.mjs --pending",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run contracts:check && npm test && npm run build && npm run check:web-performance",
    "release:check": "npm run check && npm run worker:check && npm run test:e2e && npm run test:coverage && npm audit --omit=dev",
    "audit": "npm audit --omit=dev",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "start:api": "node --env-file=.env.local src/bootstrap/http-server.mjs",
    "start:witness": "node --env-file=.env.witness.local src/bootstrap/witness-server.mjs",
    "worker:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dist",
    "worker:dev": "npm run build && wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web",
    "sdk"
  ],
  "dependencies": {
    "asn1js": "^3.0.6",
    "pg": "^8.16.3",
    "pkijs": "^3.4.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "c8": "12.0.0",
    "solc": "0.8.36",
    "wrangler": "^4.129.1"
  }
}
