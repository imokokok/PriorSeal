# Non-sensitive runtime configuration. Never commit real key paths, RPC URLs, or DATABASE_URL.
PORT=3000
# Set to production to enable fail-closed deployment checks.
PRIORSEAL_ENVIRONMENT=development
PRIORSEAL_ISSUER=priorseal-local
PRIORSEAL_KEY_ID=default
# Immutable release identifier or Git commit. Required in production and exposed by /v1/version.
PRIORSEAL_BUILD_VERSION=dev
# Domain-separates authorization signatures between deployments/tenants.
PRIORSEAL_AUTHORIZATION_AUDIENCE=priorseal
# Absolute paths mounted read-only in production. Private keys are never API input.
PRIORSEAL_PRIVATE_KEY_FILE=
PRIORSEAL_PUBLIC_KEY_FILE=
# Optional public-only registry retaining retired keys for historical receipts.
PRIORSEAL_KEY_REGISTRY_FILE=
# Optional JSON policy. Its SHA-256 hash is signed into every authorization.
PRIORSEAL_POLICY_FILE=
# Pre-execution proof: issuer (development only), rfc3161 (simplest/no Gas), witness-quorum, or evm-anchor.
PRIORSEAL_PREEXECUTION_PROOF_MODE=issuer
# Private endpoint map. Bearer tokens in this file are never embedded in receipts.
PRIORSEAL_WITNESS_ENDPOINTS_FILE=
# Optional public JSON reference to an externally submitted EVM checkpoint anchor.
# Its chain RPC must also be configured; startup rejects an unverified transaction.
PRIORSEAL_TRANSPARENCY_ANCHOR_FILE=
# Legacy compatibility switch. Prefer PRIORSEAL_PREEXECUTION_PROOF_MODE=evm-anchor.
PRIORSEAL_REQUIRE_EXTERNAL_ANCHOR=false
# Used by the offline-custody anchor preparation/recording scripts.
PRIORSEAL_ANCHOR_CHAIN_ID=
PRIORSEAL_ANCHOR_CONTRACT=
PRIORSEAL_ANCHOR_TX_HASH=
PRIORSEAL_ANCHOR_CONFIRMATIONS=12
# Comma-separated browser origins; leave empty to disable CORS.
PRIORSEAL_CORS_ORIGINS=http://localhost:5173
PRIORSEAL_TRUST_PROXY=false
# Each may contain a comma-separated, trusted endpoint list. These values are sensitive when URLs embed credentials.
PRIORSEAL_RPC_ETHEREUM=
# EVM observation networks shared with Insight's production x402 rails. Add
# only independently trusted JSON-RPC endpoints; an empty value leaves that
# execution chain unavailable while its payment rail may still be advertised.
PRIORSEAL_RPC_OP_MAINNET=
PRIORSEAL_RPC_POLYGON=
PRIORSEAL_RPC_MONAD=
PRIORSEAL_RPC_X_LAYER=
PRIORSEAL_RPC_SEI=
PRIORSEAL_RPC_BASE=
# Solana mainnet-beta JSON-RPC endpoint(s), comma-separated; no devnet/testnet.
PRIORSEAL_RPC_SOLANA_MAINNET=
# List only independently verified chain/version/address/runtime-code-hash deployments.
PRIORSEAL_ERC4337_ENTRY_POINTS_JSON=[]
# Optional Safe 4337 profile; pin the EntryPoint/module pair and proxy, singleton and module code hashes. RPC must support prestateTracer.
PRIORSEAL_SAFE_4337_TRUST_JSON=[]
# Optional EIP-7702 profile; allow only audited delegate runtime code hashes, pinned per chain.
PRIORSEAL_EIP7702_DELEGATE_TRUST_JSON=[]
# Base Sepolia pilot endpoint (chain ID 84532); 7702 observation needs prestateTracer support.
PRIORSEAL_RPC_BASE_SEPOLIA=
# Optional separate ERC-4337 bundler endpoint for Base Sepolia; confirm both bundler and delegate support the selected EntryPoint version.
# URLs may contain API keys and must stay in ignored .env.local.
PRIORSEAL_ERC4337_BUNDLER_BASE_SEPOLIA=
PRIORSEAL_RPC_ARBITRUM=
PRIORSEAL_RPC_AVALANCHE=
# Optional x402 v2 exact payments; leave every value empty to keep payment disabled.
# Configure only explicit, read-only GET routes and a production-ready facilitator.
# Set one or both payees. The EVM recipient is shared by the supported EVM
# networks; Solana uses its own mainnet USDC merchant public key.
PRIORSEAL_X402_FACILITATOR_URL=
PRIORSEAL_X402_FACILITATOR_HEADERS_JSON=
PRIORSEAL_X402_RESOURCE_ORIGIN=
PRIORSEAL_X402_PAY_TO=
PRIORSEAL_X402_SOLANA_PAY_TO=
# Comma-separated rollout allowlist. Required for staging/production whenever
# x402 is enabled. Mainnet starts with eip155:8453 or Solana mainnet. The
# isolated Base Sepolia staging rail additionally requires ENABLE_TESTNETS=true.
PRIORSEAL_X402_NETWORKS=
# Allows the explicitly allowlisted eip155:84532 test rail in staging, test,
# or development only. Production rejects this switch.
PRIORSEAL_X402_ENABLE_TESTNETS=false
# Optional staging-check subset that will also be used for subject transaction
# observation. The readiness probe validates its configured RPC chain identity.
PRIORSEAL_X402_STAGING_OBSERVATION_NETWORKS=
PRIORSEAL_X402_TIMEOUT_MS=
PRIORSEAL_X402_ROUTES_JSON=
# DATABASE_URL is the pooled application connection. DATABASE_URL_UNPOOLED is used only by migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional private uploaded-evidence archive. Store only SHA-256 token hashes here.
# Each credential binds projectId, environment and role (writer or reviewer).
# See docs/runbooks/project-evidence-archive.md. Empty disables the archive.
PRIORSEAL_ARCHIVE_CREDENTIALS_JSON=

# Standalone witness service settings (normally kept in .env.witness.local).
PRIORSEAL_WITNESS_ID=
PRIORSEAL_WITNESS_KEY_ID=
PRIORSEAL_WITNESS_PRIVATE_KEY_FILE=
PRIORSEAL_WITNESS_PUBLIC_KEY_FILE=
PRIORSEAL_WITNESS_BEARER_TOKEN=
PRIORSEAL_WITNESS_MAX_REQUEST_AGE_SECONDS=300
