PRIORSEAL_ENVIRONMENT=production
PRIORSEAL_ISSUER=priorseal.xyz
PRIORSEAL_KEY_ID=production-1
PRIORSEAL_BUILD_VERSION=0.2.0
PRIORSEAL_AUTHORIZATION_AUDIENCE=priorseal.xyz
PRIORSEAL_PRIVATE_KEY_FILE=/run/secrets/priorseal-issuer-private.pem
PRIORSEAL_PUBLIC_KEY_FILE=/run/secrets/priorseal-issuer-public.pem
PRIORSEAL_KEY_REGISTRY_FILE=/run/config/priorseal-keys.json
PRIORSEAL_POLICY_FILE=/run/config/authorization-policy.json
PRIORSEAL_ALLOW_SELF_ASSERTED_PRINCIPALS=false
PRIORSEAL_PREEXECUTION_PROOF_MODE=rfc3161
PRIORSEAL_WITNESS_ENDPOINTS_FILE=
PRIORSEAL_TRANSPARENCY_ANCHOR_FILE=
PRIORSEAL_REQUIRE_EXTERNAL_ANCHOR=false
PRIORSEAL_CORS_ORIGINS=https://priorseal.xyz,https://www.priorseal.xyz
PRIORSEAL_TRUST_PROXY=true
PRIORSEAL_ANCHOR_CHAIN_ID=8453
PRIORSEAL_ANCHOR_CONTRACT=
PRIORSEAL_ANCHOR_TX_HASH=
PRIORSEAL_ANCHOR_CONFIRMATIONS=12
DATABASE_URL=
DATABASE_URL_UNPOOLED=
