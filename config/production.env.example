RUNPROOF_ENVIRONMENT=production
RUNPROOF_ISSUER=runproof.example.com
RUNPROOF_KEY_ID=production-1
RUNPROOF_AUTHORIZATION_AUDIENCE=runproof.example.com
RUNPROOF_PRIVATE_KEY_FILE=/run/secrets/runproof-issuer-private.pem
RUNPROOF_PUBLIC_KEY_FILE=/run/secrets/runproof-issuer-public.pem
RUNPROOF_KEY_REGISTRY_FILE=/run/config/runproof-keys.json
RUNPROOF_POLICY_FILE=/run/config/authorization-policy.json
RUNPROOF_PREEXECUTION_PROOF_MODE=rfc3161
RUNPROOF_WITNESS_ENDPOINTS_FILE=
RUNPROOF_TRANSPARENCY_ANCHOR_FILE=
RUNPROOF_REQUIRE_EXTERNAL_ANCHOR=false
RUNPROOF_CORS_ORIGINS=https://runproof.example.com
RUNPROOF_TRUST_PROXY=true
RUNPROOF_ANCHOR_CHAIN_ID=8453
RUNPROOF_ANCHOR_CONTRACT=
RUNPROOF_ANCHOR_TX_HASH=
RUNPROOF_ANCHOR_CONFIRMATIONS=12
DATABASE_URL=
DATABASE_URL_UNPOOLED=
