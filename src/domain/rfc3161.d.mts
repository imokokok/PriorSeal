export function verifyTimestampEvidence(evidence: TimestampEvidence | null | undefined, data: Uint8Array, policy: unknown, options: { authorizationHash: string; requestedAt: number; before?: number; cryptoProvider?: Crypto }): Promise<{ valid: boolean; code: string; timestamp?: number; serialNumber?: string; profile?: string }>;
