{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "priorseal",
  "main": "./src/bootstrap/cloudflare-worker.mjs",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "priorseal.xyz", "custom_domain": true },
    { "pattern": "www.priorseal.xyz", "custom_domain": true }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/v1/*", "/health/*", "/.well-known/*", "/openapi/*", "/openapi.json"]
  },
  "services": [
    { "binding": "HYPERCORE_X402_FACILITATOR", "service": "hypercore-x402-facilitator" }
  ],
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "vars": {
    "PRIORSEAL_ENVIRONMENT": "production",
    "PRIORSEAL_ISSUER": "priorseal.xyz",
    "PRIORSEAL_KEY_ID": "production-1",
    "PRIORSEAL_AUTHORIZATION_AUDIENCE": "priorseal.xyz",
    "PRIORSEAL_PREEXECUTION_PROOF_MODE": "rfc3161",
    "PRIORSEAL_PUBLIC_PAID_COMMERCE_ENABLED": "true",
    "PRIORSEAL_CORS_ORIGINS": "https://priorseal.xyz,https://www.priorseal.xyz",
    "PRIORSEAL_TRUST_PROXY": "true",
    "PRIORSEAL_X402_FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
    "PRIORSEAL_X402_FACILITATOR_AUTH_MODE": "cdp",
    "PRIORSEAL_X402_RESOURCE_ORIGIN": "https://priorseal.xyz",
    "PRIORSEAL_X402_PAY_TO": "0x5FBbbCbF2Ade44F5c604E5E55f11945E1ADdD231",
    "PRIORSEAL_X402_SOLANA_PAY_TO": "BfVX9jcEALijnEuGPcGTjqjBgTFLTFMt6F7NrMHzGWf4",
    "PRIORSEAL_X402_FACILITATOR_URLS": "eip155:56=https://facilitator.aeon.xyz,eip155:999=https://facilitator.ultravioletadao.xyz,solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp=https://facilitator.payai.network",
    "PRIORSEAL_X402_NETWORKS": "eip155:8453,eip155:999",
    "PRIORSEAL_X402_STANDARD_RAILS_ENABLED": "true",
    "PRIORSEAL_HYPERCORE_X402_ENABLED": "true",
    "PRIORSEAL_HYPERCORE_X402_FACILITATOR_URL": "https://hypercore-x402-facilitator.priorseal.workers.dev",
    "PRIORSEAL_HYPERCORE_X402_MERCHANT_ID": "priorseal",
    "PRIORSEAL_HYPERCORE_X402_NETWORK": "hyperliquid:mainnet",
    "PRIORSEAL_HYPERCORE_X402_PAY_TO": "0x5FBbbCbF2Ade44F5c604E5E55f11945E1ADdD231",
    "PRIORSEAL_X402_TIMEOUT_MS": "15000",
    "PRIORSEAL_X402_ROUTES_JSON": "[{\"method\":\"GET\",\"path\":\"/v1/receipts/:receiptId/bundle\",\"description\":\"Review-layer export of a Verified Action: a portable bundle proving what the principal authorized (Seal), that approval preceded execution (Witness), and whether observed execution matched the approved boundaries (Match), independently verifiable by third parties. Per-call x402 v2 export in USDC.\",\"price\":\"$0.02\"},{\"method\":\"GET\",\"path\":\"/v1/integration-readiness/smoke\",\"description\":\"Verify x402 payment and signed delivery compatibility; this does not inspect your Agent target\",\"price\":\"$0.02\",\"bazaar\":{\"input\":{\"queryParams\":{\"chainId\":\"8453\"},\"querySchema\":{\"properties\":{\"chainId\":{\"type\":\"string\",\"pattern\":\"^[1-9][0-9]{0,9}$\"}},\"required\":[\"chainId\"]}},\"output\":{\"format\":\"priorseal.integration-readiness.v1\",\"example\":{\"schema\":\"priorseal.integration-readiness.v1\",\"workflow\":{\"stage\":\"SMOKE_TEST\"}}}}},{\"method\":\"GET\",\"path\":\"/v1/integration-readiness\",\"description\":\"Issue a signed readiness report for the public EVM address your Agent will actually integrate; chainId and a non-zero subjectAddress are required\",\"price\":\"$0.02\",\"bazaar\":{\"input\":{\"queryParams\":{\"chainId\":\"8453\",\"subjectAddress\":\"{publicEvmAddress}\"},\"querySchema\":{\"properties\":{\"chainId\":{\"type\":\"string\",\"pattern\":\"^[1-9][0-9]{0,9}$\"},\"subjectAddress\":{\"type\":\"string\",\"pattern\":\"^0x[0-9a-fA-F]{40}$\",\"description\":\"Replace {publicEvmAddress} with the non-zero public EVM address your Agent will actually integrate.\"}},\"required\":[\"chainId\",\"subjectAddress\"]}},\"output\":{\"format\":\"priorseal.integration-readiness.v1\",\"example\":{\"schema\":\"priorseal.integration-readiness.v1\",\"workflow\":{\"stage\":\"TARGET_INSPECTED\"}}}}},{\"method\":\"GET\",\"path\":\"/v1/agent-credit-packs/standard-100/checkout\",\"description\":\"Purchase 100 PriorSeal Agent Credits for an existing authenticated Agent account\",\"price\":\"$1.00\"}]",
    "PRIORSEAL_X402_CREDIT_PACKS_JSON": "{\"schema\":\"priorseal.x402-credit-packs.v1\",\"packs\":[{\"packId\":\"standard-100\",\"credits\":\"100\",\"priceUsd\":\"1.00\"}]}"
  },
  "secrets": {
    "required": [
      "PRIORSEAL_PRIVATE_KEY_PEM",
      "PRIORSEAL_PUBLIC_KEY_PEM",
      "PRIORSEAL_POLICY_JSON",
      "PRIORSEAL_ALLOW_SELF_ASSERTED_PRINCIPALS",
      "PRIORSEAL_RPC_ETHEREUM",
      "PRIORSEAL_RPC_BASE",
      "PRIORSEAL_RPC_ARBITRUM",
      "PRIORSEAL_RPC_BNB",
      "PRIORSEAL_RPC_MONAD",
      "PRIORSEAL_RPC_HYPEREVM",
      "PRIORSEAL_RPC_SOLANA_MAINNET",
      "PRIORSEAL_HYPERLIQUID_ENABLED",
      "PRIORSEAL_HYPERLIQUID_INFO_URL",
      "INSIGHT_API_KEY",
      "PRIORSEAL_AGENT_METER_JSON",
      "PRIORSEAL_X402_CDP_API_KEY_ID",
      "PRIORSEAL_X402_CDP_API_KEY_SECRET",
      "PRIORSEAL_HYPERCORE_X402_MERCHANT_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "priorseal-production",
      "database_id": "5d1d57aa-0a67-48e6-a60f-8015b079d3bb",
      "migrations_dir": "d1/migrations"
    }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "ratelimits": [
    {
      "name": "HTTP_RATE_LIMITER",
      "namespace_id": "2026091301",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "queues": {
    "producers": [
      { "binding": "OBSERVATION_QUEUE", "queue": "priorseal-observations" }
    ],
    "consumers": [
      {
        "queue": "priorseal-observations",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 10
      }
    ]
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "env": {
    "staging": {
      "assets": {
        "directory": "./web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/mcp", "/v1/*", "/health/*", "/.well-known/*", "/openapi/*"]
      },
      "routes": [],
      "services": [
        { "binding": "HYPERCORE_X402_FACILITATOR", "service": "hypercore-x402-facilitator-testnet" }
      ],
      "vars": {
        "PRIORSEAL_ENVIRONMENT": "staging",
        "PRIORSEAL_ISSUER": "priorseal-staging",
        "PRIORSEAL_KEY_ID": "staging-1",
        "PRIORSEAL_BUILD_VERSION": "staging",
        "PRIORSEAL_AUTHORIZATION_AUDIENCE": "priorseal-staging",
        "PRIORSEAL_PREEXECUTION_PROOF_MODE": "rfc3161",
        "PRIORSEAL_PUBLIC_PAID_COMMERCE_ENABLED": "true",
        "PRIORSEAL_DATABASE_BACKEND": "d1",
        "PRIORSEAL_ALLOW_SELF_ASSERTED_PRINCIPALS": "false",
        "PRIORSEAL_CORS_ORIGINS": "",
        "PRIORSEAL_TRUST_PROXY": "true",
        "PRIORSEAL_X402_FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
        "PRIORSEAL_X402_FACILITATOR_AUTH_MODE": "cdp",
        "PRIORSEAL_X402_RESOURCE_ORIGIN": "https://priorseal-staging.priorseal.workers.dev",
        "PRIORSEAL_X402_PAY_TO": "0x5FBbbCbF2Ade44F5c604E5E55f11945E1ADdD231",
        "PRIORSEAL_X402_SOLANA_PAY_TO": "BfVX9jcEALijnEuGPcGTjqjBgTFLTFMt6F7NrMHzGWf4",
        "PRIORSEAL_X402_FACILITATOR_URLS": "eip155:56=https://facilitator.aeon.xyz,solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp=https://facilitator.payai.network",
        "PRIORSEAL_X402_ENABLE_TESTNETS": "true",
        "PRIORSEAL_X402_NETWORKS": "eip155:84532",
        "PRIORSEAL_X402_STANDARD_RAILS_ENABLED": "true",
        "PRIORSEAL_X402_STAGING_OBSERVATION_NETWORKS": "eip155:84532",
        "PRIORSEAL_HYPERCORE_X402_ENABLED": "true",
        "PRIORSEAL_HYPERCORE_X402_FACILITATOR_URL": "https://hypercore-x402-facilitator-testnet.priorseal.workers.dev",
        "PRIORSEAL_HYPERCORE_X402_MERCHANT_ID": "priorseal",
        "PRIORSEAL_HYPERCORE_X402_NETWORK": "hyperliquid:testnet",
        "PRIORSEAL_HYPERCORE_X402_PAY_TO": "0x5FBbbCbF2Ade44F5c604E5E55f11945E1ADdD231",
        "PRIORSEAL_X402_TIMEOUT_MS": "15000",
        "PRIORSEAL_X402_ROUTES_JSON": "[{\"method\":\"GET\",\"path\":\"/v1/receipts/:receiptId/bundle\",\"description\":\"Staging x402 receipt-bundle rehearsal\",\"price\":\"$0.01\"},{\"method\":\"GET\",\"path\":\"/v1/integration-readiness/smoke\",\"description\":\"Staging x402 payment and signed-delivery compatibility test\",\"price\":\"$0.01\",\"bazaar\":{\"input\":{\"queryParams\":{\"chainId\":\"84532\"},\"querySchema\":{\"properties\":{\"chainId\":{\"type\":\"string\",\"pattern\":\"^[1-9][0-9]{0,9}$\"}},\"required\":[\"chainId\"]}},\"output\":{\"format\":\"priorseal.integration-readiness.v1\",\"example\":{\"schema\":\"priorseal.integration-readiness.v1\",\"workflow\":{\"stage\":\"SMOKE_TEST\"}}}}},{\"method\":\"GET\",\"path\":\"/v1/integration-readiness\",\"description\":\"Issue a signed readiness report for the public EVM address your Agent will actually integrate; chainId and a non-zero subjectAddress are required\",\"price\":\"$0.01\",\"bazaar\":{\"input\":{\"queryParams\":{\"chainId\":\"84532\",\"subjectAddress\":\"{publicEvmAddress}\"},\"querySchema\":{\"properties\":{\"chainId\":{\"type\":\"string\",\"pattern\":\"^[1-9][0-9]{0,9}$\"},\"subjectAddress\":{\"type\":\"string\",\"pattern\":\"^0x[0-9a-fA-F]{40}$\",\"description\":\"Replace {publicEvmAddress} with the non-zero public EVM address your Agent will actually integrate.\"}},\"required\":[\"chainId\",\"subjectAddress\"]}},\"output\":{\"format\":\"priorseal.integration-readiness.v1\",\"example\":{\"schema\":\"priorseal.integration-readiness.v1\",\"workflow\":{\"stage\":\"TARGET_INSPECTED\"}}}}},{\"method\":\"GET\",\"path\":\"/v1/agent-credit-packs/staging-10/checkout\",\"description\":\"Staging x402 purchase of 10 PriorSeal Agent Credits\",\"price\":\"$0.10\"}]",
        "PRIORSEAL_X402_CREDIT_PACKS_JSON": "{\"schema\":\"priorseal.x402-credit-packs.v1\",\"packs\":[{\"packId\":\"staging-10\",\"credits\":\"10\",\"priceUsd\":\"0.10\"}]}"
      },
      "secrets": {
        "required": [
          "PRIORSEAL_PRIVATE_KEY_PEM",
          "PRIORSEAL_PUBLIC_KEY_PEM",
          "PRIORSEAL_POLICY_JSON",
          "PRIORSEAL_RPC_BASE_SEPOLIA",
          "PRIORSEAL_AGENT_METER_JSON",
          "PRIORSEAL_X402_CDP_API_KEY_ID",
          "PRIORSEAL_X402_CDP_API_KEY_SECRET",
          "PRIORSEAL_HYPERCORE_X402_MERCHANT_SECRET"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "priorseal-staging",
          "database_id": "2a1ac01a-af10-4f2d-918e-41e8c13d39da",
          "migrations_dir": "d1/migrations"
        }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ratelimits": [
        {
          "name": "HTTP_RATE_LIMITER",
          "namespace_id": "2026101601",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "queues": {
        "producers": [
          { "binding": "OBSERVATION_QUEUE", "queue": "priorseal-staging-observations" }
        ],
        "consumers": [
          {
            "queue": "priorseal-staging-observations",
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            "max_retries": 10
          }
        ]
      },
      "triggers": { "crons": ["*/15 * * * *"] },
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.1 }
      }
    }
  }
}
