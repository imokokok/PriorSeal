{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "priorseal-transaction-recovery-demo",
  "main": "./src/demo/transaction-recovery-worker.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/demo-api/*"]
  }
}
