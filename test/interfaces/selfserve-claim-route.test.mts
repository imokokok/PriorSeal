import test from 'node:test';
// TypeScript source; the matching .mjs file is generated by npm run core:build.
import assert from 'node:assert/strict';
import { EventEmitter } from 'node:events';
import { Readable } from 'node:stream';
import { createHttpServer, createMemoryStore } from '../../src/index.mjs';
import { createRpcClient } from '../../src/infrastructure/blockchain/evm/rpc-client.mjs';
import { createSelfserveClaim, selfserveClaimMessage, type SelfserveClaimConfig } from '../../src/application/commerce/selfserve-claim.mjs';
import { privateKeyToAccount } from 'viem/accounts';

const PAY_TO = '0x5fbbbcbf2ade44f5c604e5e55f11945e1addd231';
const USDC = '0x833589fcd6edb6e08f4c7c32d4f71b54bda02913';
const PAYER_KEY = '0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d';
const BLOCK_HASH = `0x${'1'.repeat(64)}`;
const payer = privateKeyToAccount(PAYER_KEY);

function claimConfig(): SelfserveClaimConfig {
  return { schema: 'priorseal.selfserve-claim.v1', chainId: 8453, payTo: PAY_TO, usdcAddress: USDC, minRawUnits: 1_000_000n, rawUnitsPerCredit: 10_000n, credentialKeyHex: 'ab'.repeat(32) };
}

function fakeFetch(transfers: Map<string, { from: string; input: string }>) {
  const respond = (result: unknown) => new Response(JSON.stringify({ jsonrpc: '2.0', id: 1, result }), { status: 200, headers: { 'content-type': 'application/json' } });
  return (async (_url: unknown, init?: { body?: string }) => {
    const { method, params } = JSON.parse(init?.body ?? '{}') as { method: string; params: string[] };
    const entry = transfers.get(params[0]);
    if (method === 'eth_getTransactionByHash') {
      return respond(entry ? { hash: params[0], nonce: '0x0', from: entry.from, to: USDC, value: '0x0', input: entry.input, gasPrice: '0x1', blockNumber: '0x1', blockHash: BLOCK_HASH } : null);
    }
    if (method === 'eth_getTransactionReceipt') {
      return respond(entry ? { status: '0x1', blockNumber: '0x2', gasUsed: '0x5208', blockHash: BLOCK_HASH, transactionHash: params[0], logs: [] } : null);
    }
    return respond(null);
  }) as typeof fetch;
}

function serverFor(t: import('node:test').TestContext, withClaim: boolean) {
  const transfers = new Map<string, { from: string; input: string }>();
  const txHash = `0x${'a'.repeat(64)}`;
  transfers.set(txHash, { from: payer.address.toLowerCase(), input: `0xa9059cbb${'0'.repeat(24)}${PAY_TO.slice(2)}${(1_500_000n).toString(16).padStart(64, '0')}` });
  const claim = withClaim
    ? createSelfserveClaim(claimConfig(), { store: createMemoryStore(), rpc: createRpcClient({ fetchImpl: fakeFetch(transfers), retries: 0 }), rpcUrls: () => ['https://base-rpc.test'] })
    : null;
  const server = createHttpServer({ store: createMemoryStore(), selfserveClaim: claim });
  t.after(() => server.close());
  return { server, txHash };
}

type MockResponse = EventEmitter & {
  writableEnded: boolean; destroyed: boolean; status?: number; headers?: Record<string, string>; body?: string | Buffer;
  writeHead(status: number, headers: Record<string, string>): MockResponse; end(value?: string | Buffer): void;
};

async function request(server: ReturnType<typeof createHttpServer>, path: string, { method = 'GET', headers = {}, body }: { method?: string; headers?: Record<string, string>; body?: string } = {}) {
  const req = Readable.from(body ? [Buffer.from(body)] : []);
  Object.assign(req, { method, url: path, headers, socket: { remoteAddress: '127.0.0.1' } });
  const res = new EventEmitter() as MockResponse;
  res.writableEnded = false; res.destroyed = false;
  res.writeHead = (status, responseHeaders) => { res.status = status; res.headers = responseHeaders; return res; };
  res.end = (value) => { res.writableEnded = true; res.body = value; res.emit('finish'); res.emit('close'); };
  const done = new Promise<void>((resolve) => res.once('finish', resolve));
  server.emit('request', req, res);
  await done;
  return { status: res.status, headers: res.headers ?? {}, json: () => JSON.parse(Buffer.from(res.body ?? '').toString('utf8')) as Record<string, unknown> };
}

test('POST /v1/selfserve/claim provisions a funded account and returns the credential', async (t) => {
  const { server, txHash } = serverFor(t, true);
  const signature = await payer.signMessage({ message: selfserveClaimMessage(PAY_TO, txHash) });
  const response = await request(server, '/v1/selfserve/claim', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ txHash, signature }) });
  assert.equal(response.status, 201);
  assert.equal(response.json().credits, '150');
  assert.match(response.json().credential as string, /^psa_/);
  assert.equal(response.json().account && (response.json().account as Record<string, unknown>).accountId, `selfserve-${payer.address.toLowerCase().slice(2, 10)}`);
  const replay = await request(server, '/v1/selfserve/claim', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ txHash, signature }) });
  assert.equal(replay.status, 200);
  assert.equal(replay.json().credential, response.json().credential);
});

test('POST /v1/selfserve/claim rejects unknown fields and undisclosed transactions', async (t) => {
  const { server, txHash } = serverFor(t, true);
  const signature = await payer.signMessage({ message: selfserveClaimMessage(PAY_TO, txHash) });
  const unknownField = await request(server, '/v1/selfserve/claim', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ txHash, signature, extra: true }) });
  assert.equal(unknownField.status, 400);
  const unknownTx = await request(server, '/v1/selfserve/claim', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ txHash: `0x${'e'.repeat(64)}`, signature: await payer.signMessage({ message: selfserveClaimMessage(PAY_TO, `0x${'e'.repeat(64)}`) }) }) });
  assert.equal(unknownTx.status, 404);
  assert.equal((unknownTx.json().error as Record<string, unknown>).code, 'CLAIM_TX_NOT_FOUND');
});

test('the claim route stays absent when self-serve funding is not configured', async (t) => {
  const { server, txHash } = serverFor(t, false);
  const response = await request(server, '/v1/selfserve/claim', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ txHash, signature: `0x${'ab'.repeat(65)}` }) });
  assert.equal(response.status, 404);
});

test('capabilities advertise the claim endpoint when configured and omit it otherwise', async (t) => {
  const withClaim = serverFor(t, true);
  const capabilities = await request(withClaim.server, '/v1/capabilities');
  const claim = (capabilities.json().payments as Record<string, Record<string, unknown>>).selfserveClaim;
  assert.equal(claim.configured, true);
  assert.equal(claim.path, '/v1/selfserve/claim');
  assert.equal(claim.payTo, PAY_TO);
  assert.equal(claim.minPayUsd, '1.00');
  assert.equal(claim.creditUnitUsd, '0.01');
  const withoutClaim = serverFor(t, false);
  const absent = await request(withoutClaim.server, '/v1/capabilities');
  assert.equal(((absent.json().payments as Record<string, Record<string, unknown>>).selfserveClaim as Record<string, unknown>).configured, false);
});
