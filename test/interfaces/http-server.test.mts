type TestServer = ReturnType<typeof createHttpServer>;
type ServerOptions = NonNullable<Parameters<typeof createHttpServer>[0]>;
type ObserverResult = Awaited<ReturnType<NonNullable<ServerOptions['observer']>>>;
type HttpTestResponse = {
  error: { code: string; details: { reasonCodes: string[] } };
  verification: { valid: boolean };
  id: string;
  items: Array<{ artifact: unknown }>;
  role: string;
  retention: string;
  nextCursor: string | null;
  status: string;
  receipt: { receiptId: string; schema: string; executionStatus: string; compliance: { status: string }; binding: { bound: boolean } };
  authorization: { authorizationId: string };
  result: { valid: boolean };
  observationJob: { jobId: string };
  observation: { status: string };
  schema: string;
  keyRegistry: { keys: Array<{ keyId: string }> };
  trust: { model: string };
  bundleHash: string;
  type: string;
  name: string;
  x402Support: boolean;
  x402: { payTo: string; networks: string[] };
  active: boolean;
  provider: string;
};
type RequestOptions = {
  method?: string;
  headers?: Record<string, string>;
  body?: string;
  stream?: Readable;
};
type MockResponse = EventEmitter & {
  writableEnded: boolean;
  destroyed: boolean;
  status?: number;
  headers?: Record<string, string>;
  body?: string | Buffer;
  writeHead(status: number, headers: Record<string, string>): MockResponse;
  end(value?: string | Buffer): void;
};

async function serverFor(testContext: TestContext) {
  const server = createHttpServer({ observer: async () => ({ chainId: 8453, txHash: `0x${'1'.repeat(64)}`, status: 'PENDING', sender, recipient, finalityState: 'PENDING' }) as unknown as ObserverResult });
  testContext.after(() => server.close()); return server;
}
async function request(server: TestServer, path: string, { method = 'GET', headers = {}, body, stream }: RequestOptions = {}) {
  const req = stream ?? Readable.from(body ? [Buffer.from(body)] : []); Object.assign(req, { method, url: path, headers, socket: { remoteAddress: '127.0.0.1' } });
  const res = new EventEmitter() as MockResponse; res.writableEnded = false; res.destroyed = false; res.writeHead = (status, responseHeaders) => { res.status = status; res.headers = responseHeaders; return res; }; res.end = (value) => { res.writableEnded = true; res.body = value; res.emit('finish'); res.emit('close'); };
  const done = new Promise<void>((resolve) => res.once('finish', resolve)); server.emit('request', req, res); await done; return { status: res.status, headers: res.headers ?? {}, buffer: () => Buffer.from(res.body ?? ''), json: (): HttpTestResponse => JSON.parse(Buffer.from(res.body ?? '').toString('utf8')) as HttpTestResponse, text: () => Buffer.from(res.body ?? '').toString('utf8') };
}

test('PriorSeal MCP exposes stateless discovery, deterministic tools, and a JSON-only capability call', async (t) => {
  const server = await serverFor(t);
  const modernHeaders = { 'content-type': 'application/json', accept: 'application/json, text/event-stream', 'mcp-protocol-version': '2026-07-28' };
  const discovered = await request(server, '/mcp', {
    method: 'POST', headers: { ...modernHeaders, 'mcp-method': 'server/discover' },
    body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'server/discover', params: { _meta: { 'io.modelcontextprotocol/protocolVersion': '2026-07-28', 'io.modelcontextprotocol/clientInfo': { name: 'test', version: '1.0.0' }, 'io.modelcontextprotocol/clientCapabilities': {} } } }),
  });
  assert.equal(discovered.status, 200);
  const discovery = discovered.json() as unknown as { result: { resultType: string; supportedVersions: string[]; capabilities: { tools: { listChanged: boolean } } } };
  assert.equal(discovery.result.resultType, 'complete');
  assert.deepEqual(discovery.result.supportedVersions, ['2026-07-28']);
  assert.equal(discovery.result.capabilities.tools.listChanged, false);

  const listed = await request(server, '/mcp', {
    method: 'POST', headers: { ...modernHeaders, 'mcp-method': 'tools/list' },
    body: JSON.stringify({ jsonrpc: '2.0', id: 2, method: 'tools/list', params: { _meta: { 'io.modelcontextprotocol/protocolVersion': '2026-07-28', 'io.modelcontextprotocol/clientInfo': { name: 'test', version: '1.0.0' }, 'io.modelcontextprotocol/clientCapabilities': {} } } }),
  });
  const listedResult = listed.json() as unknown as { result: { tools: { name: string; annotations: Record<string, unknown>; outputSchema: { required: string[] } }[] } };
  const toolNames = listedResult.result.tools.map(tool => tool.name);
  assert.deepEqual(toolNames, ['priorseal_get_capabilities', 'priorseal_prepare_authorization', 'priorseal_prepare_controlled_execution', 'priorseal_accept_authorization', 'priorseal_get_authorization', 'priorseal_observe_execution', 'priorseal_get_observation_job', 'priorseal_get_receipt', 'priorseal_get_evidence_bundle', 'priorseal_get_evidence', 'priorseal_verify_receipt']);
  const byName = new Map(listedResult.result.tools.map(tool => [tool.name, tool]));
  assert.deepEqual(byName.get('priorseal_get_receipt')!.annotations, { readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false });
  assert.deepEqual(byName.get('priorseal_accept_authorization')!.annotations, { readOnlyHint: false, destructiveHint: false, idempotentHint: false, openWorldHint: true });
  assert.ok(byName.get('priorseal_observe_execution')!.outputSchema.required.includes('mayBroadcastTransaction'));

  const capabilities = await request(server, '/mcp', {
    method: 'POST', headers: { ...modernHeaders, 'mcp-method': 'tools/call', 'mcp-name': 'priorseal_get_capabilities' },
    body: JSON.stringify({ jsonrpc: '2.0', id: 3, method: 'tools/call', params: { name: 'priorseal_get_capabilities', arguments: {}, _meta: { 'io.modelcontextprotocol/protocolVersion': '2026-07-28', 'io.modelcontextprotocol/clientInfo': { name: 'test', version: '1.0.0' }, 'io.modelcontextprotocol/clientCapabilities': {} } } }),
  });
  const result = capabilities.json() as unknown as { result: { resultType: string; structuredContent: { schema: string; tool: string; status: string; nextAction: string; requiresHumanSignature: boolean; mayBroadcastTransaction: boolean; risk: { level: string; reasonCode: string }; data: { schema: string } } } };
  assert.equal(result.result.resultType, 'complete');
  assert.equal(result.result.structuredContent.schema, 'priorseal.mcp.tool-result.v1');
  assert.equal(result.result.structuredContent.tool, 'priorseal_get_capabilities');
  assert.equal(result.result.structuredContent.status, 'capabilities_loaded');
  assert.equal(result.result.structuredContent.nextAction, 'select_supported_workflow');
  assert.equal(result.result.structuredContent.requiresHumanSignature, false);
  assert.equal(result.result.structuredContent.mayBroadcastTransaction, false);
  assert.deepEqual(result.result.structuredContent.risk, { level: 'read_only', reasonCode: 'CAPABILITIES_READ' });
  assert.equal(result.result.structuredContent.data.schema, 'priorseal.capabilities.v1');
});
test('PriorSeal MCP prepares a safe controlled-execution handoff without accepting or submitting an action', async (t) => {
  const account = `0x${'c'.repeat(40)}`;
  const input = {
    intent,
    principal: { type: 'user', id: 'user-test', account },
    authorizer: { type: 'eip712', address: account },
    delegate: { agentId: 'agent-test', executor: sender },
    issuedAt: 1_000,
    expiresAt: intent.validUntil,
    authorizationNonce: `0x${'4'.repeat(64)}`,
    maxUses: '1',
    audience: 'priorseal',
  };
  const server = createHttpServer({ policy: { allowedChainIds: [8453], maxAmount: '1000000' } });
  t.after(() => server.close());
  const response = await request(server, '/mcp', {
    method: 'POST', headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ jsonrpc: '2.0', id: 4, method: 'tools/call', params: { name: 'priorseal_prepare_controlled_execution', arguments: { input } } }),
  });
  const result = response.json() as unknown as { result: { structuredContent: { status: string; nextAction: string; requiresHumanSignature: boolean; mayBroadcastTransaction: boolean; data: { authorization: { authorizationId: string }; capabilities: { schema: string }; controlledExecution: { schema: string; state: string; mayBroadcastTransaction: boolean; steps: Array<{ action?: string; tool?: string; status: string }> } } } } };
  assert.equal(response.status, 200);
  assert.equal(result.result.structuredContent.status, 'controlled_execution_prepared');
  assert.equal(result.result.structuredContent.nextAction, 'request_principal_signature');
  assert.equal(result.result.structuredContent.requiresHumanSignature, true);
  assert.equal(result.result.structuredContent.mayBroadcastTransaction, false);
  assert.match(result.result.structuredContent.data.authorization.authorizationId, /^auth_/);
  assert.equal(result.result.structuredContent.data.capabilities.schema, 'priorseal.capabilities.v1');
  assert.equal(result.result.structuredContent.data.controlledExecution.schema, 'priorseal.controlled-execution-workflow.v1');
  assert.equal(result.result.structuredContent.data.controlledExecution.state, 'AWAITING_PRINCIPAL_SIGNATURE');
  assert.equal(result.result.structuredContent.data.controlledExecution.mayBroadcastTransaction, false);
  assert.deepEqual(result.result.structuredContent.data.controlledExecution.steps.map(step => [step.action ?? step.tool, step.status]), [
    ['review_prepared_authorization', 'COMPLETE'], ['request_principal_signature', 'REQUIRED'], ['priorseal_accept_authorization', 'REQUIRED'], ['submit_exact_authorized_action', 'EXTERNAL'], ['priorseal_observe_execution', 'REQUIRED'], ['priorseal_get_evidence_bundle', 'REQUIRED'],
  ]);
});
test('PriorSeal MCP maps metered mutations to the existing Agent credit route and releases failed calls', async (t) => {
  const secret = 'agent-secret-that-is-long-enough-for-a-commercial-service-boundary';
  const store = createMemoryStore();
  const meter = createAgentMeter(parseAgentMeterConfig({
    schema: 'priorseal.agent-meter.v1', creditUnitUsd: '0.01', operatorCredentialHash: agentCredentialHash('operator-secret-that-is-long-enough-for-a-commercial-service-boundary'),
    accounts: [{ accountId: 'team:mcp', credentialHash: agentCredentialHash(secret), provisionedCredits: '1', status: 'active' }],
    routes: [{ routeId: 'authorization-acceptance', method: 'POST', path: '/v1/authorizations', credits: '1' }],
  }), store);
  const server = createHttpServer({ store, agentMeter: meter });
  t.after(() => server.close());
  const response = await request(server, '/mcp', {
    method: 'POST', headers: { 'content-type': 'application/json', 'x-priorseal-agent-key': secret, 'idempotency-key': 'mcp-failed-authorization' },
    body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: 'priorseal_accept_authorization', arguments: { input: {} } } }),
  });
  assert.equal(response.status, 200);
  const toolResult = response.json() as unknown as { result: { isError: boolean; content: { text: string }[]; structuredContent: { schema: string; tool: string; status: string; nextAction: string; mayBroadcastTransaction: boolean; risk: { level: string }; data: { error: { code: string } } } } };
  assert.equal(toolResult.result.isError, true);
  assert.match(toolResult.result.content[0].text, /INVALID_AUTHORIZATION|INVALID_REQUEST|ISSUER_NOT_CONFIGURED/);
  assert.equal(toolResult.result.structuredContent.schema, 'priorseal.mcp.tool-result.v1');
  assert.equal(toolResult.result.structuredContent.tool, 'priorseal_accept_authorization');
  assert.equal(toolResult.result.structuredContent.status, 'error');
  assert.match(toolResult.result.structuredContent.nextAction, /^(correct_input|review_error)$/);
  assert.equal(toolResult.result.structuredContent.mayBroadcastTransaction, false);
  assert.equal(toolResult.result.structuredContent.risk.level, 'input_or_service_error');
  assert.match(toolResult.result.structuredContent.data.error.code, /INVALID_AUTHORIZATION|INVALID_REQUEST|ISSUER_NOT_CONFIGURED/);
  assert.match(String(response.headers['x-priorseal-usage-id']), /^amu_[0-9a-f]{32}$/);
  assert.equal((await meter!.inspect(secret)).remainingCredits, '1');
});
test('metered agent calls require a credential, consume only successful calls and expose their usage record', async (t) => {
  const secret = 'agent-secret-that-is-long-enough-for-a-commercial-service-boundary';
  const store = createMemoryStore();
  const meter = createAgentMeter(parseAgentMeterConfig({
    schema: 'priorseal.agent-meter.v1',
    creditUnitUsd: '0.01',
    operatorCredentialHash: agentCredentialHash('operator-secret-that-is-long-enough-for-a-commercial-service-boundary'),
    accounts: [{ accountId: 'team:alpha', credentialHash: agentCredentialHash(secret), provisionedCredits: '1', status: 'active' }],
    routes: [{ routeId: 'capabilities', method: 'GET', path: '/v1/capabilities', credits: '1' }],
  }), store);
  const server = createHttpServer({ store, agentMeter: meter });
  t.after(() => server.close());
  const denied = await request(server, '/v1/capabilities', { headers: { 'idempotency-key': 'agent-call-1' } });
  assert.equal(denied.status, 401);
  const paid = await request(server, '/v1/capabilities', { headers: { 'idempotency-key': 'agent-call-1', 'x-priorseal-agent-key': secret } });
  assert.equal(paid.status, 200);
  assert.match(String(paid.headers['x-priorseal-usage-id']), /^amu_[0-9a-f]{32}$/);
  const agentCredits = (paid.json() as unknown as { payments: { agentCredits: { creditUnitUsd: string; routes: { priceUsd: string }[] } } }).payments.agentCredits;
  assert.equal(agentCredits.creditUnitUsd, '0.01');
  assert.deepEqual(agentCredits.routes.map(route => route.priceUsd), ['0.01']);
  const replay = await request(server, '/v1/capabilities', { headers: { 'idempotency-key': 'agent-call-1', 'x-priorseal-agent-key': secret } });
  assert.equal(replay.status, 200);
  assert.equal(replay.headers['x-priorseal-usage-id'], paid.headers['x-priorseal-usage-id']);
  const usage = await request(server, '/v1/agent-accounts/self/usage?limit=1', { headers: { 'x-priorseal-agent-key': secret } });
  assert.equal(usage.status, 200);
  assert.deepEqual((usage.json() as unknown as { items: { routeId: string; state: string }[] }).items.map(entry => [entry.routeId, entry.state]), [['capabilities', 'CONSUMED']]);
  const exhausted = await request(server, '/v1/capabilities', { headers: { 'idempotency-key': 'agent-call-2', 'x-priorseal-agent-key': secret } });
  assert.equal(exhausted.status, 402);
  assert.equal(exhausted.json().error.code, 'AGENT_CREDITS_EXHAUSTED');
});
test('operator endpoints issue, inspect, credit, and revoke a narrowly scoped Agent service account', async (t) => {
  const operatorSecret = 'operator-secret-that-is-long-enough-for-a-commercial-service-boundary';
  const meter = createAgentMeter(parseAgentMeterConfig({
    schema: 'priorseal.agent-meter.v1', creditUnitUsd: '0.01', operatorCredentialHash: agentCredentialHash(operatorSecret), accounts: [],
    routes: [],
  }), createMemoryStore());
  const server = createHttpServer({ agentMeter: meter });
  t.after(() => server.close());
  const denied = await request(server, '/v1/agent-accounts', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ accountId: 'team:issued', provisionedCredits: '2' }) });
  assert.equal(denied.status, 403);
  const issued = await request(server, '/v1/agent-accounts', { method: 'POST', headers: { 'content-type': 'application/json', 'x-priorseal-operator-key': operatorSecret }, body: JSON.stringify({ accountId: 'team:issued', provisionedCredits: '2' }) });
  assert.equal(issued.status, 201);
  const credential = (issued.json() as unknown as { credential: string }).credential;
  assert.match(credential, /^psa_[A-Za-z0-9_-]{43}$/);
  const self = await request(server, '/v1/agent-accounts/self', { headers: { 'x-priorseal-agent-key': credential } });
  assert.equal(self.status, 200);
  assert.equal((self.json() as unknown as { account: { remainingCredits: string } }).account.remainingCredits, '2');
  const missingIdempotency = await request(server, '/v1/agent-accounts/team:issued/credits', { method: 'POST', headers: { 'content-type': 'application/json', 'x-priorseal-operator-key': operatorSecret }, body: JSON.stringify({ credits: '3' }) });
  assert.equal(missingIdempotency.status, 400);
  const credited = await request(server, '/v1/agent-accounts/team:issued/credits', { method: 'POST', headers: { 'content-type': 'application/json', 'x-priorseal-operator-key': operatorSecret, 'idempotency-key': 'credit-1' }, body: JSON.stringify({ credits: '3', reference: 'invoice:1' }) });
  assert.equal(credited.status, 201);
  assert.equal((credited.json() as unknown as { account: { remainingCredits: string } }).account.remainingCredits, '5');
  assert.match((credited.json() as unknown as { operation: { operationId: string } }).operation.operationId, /^aco_[0-9a-f]{32}$/);
  const replayedCredit = await request(server, '/v1/agent-accounts/team:issued/credits', { method: 'POST', headers: { 'content-type': 'application/json', 'x-priorseal-operator-key': operatorSecret, 'idempotency-key': 'credit-1' }, body: JSON.stringify({ credits: '3', reference: 'invoice:1' }) });
  assert.equal(replayedCredit.status, 200);
  assert.equal(replayedCredit.headers['idempotency-replayed'], 'true');
  assert.equal((replayedCredit.json() as unknown as { account: { remainingCredits: string } }).account.remainingCredits, '5');
  const revoked = await request(server, '/v1/agent-accounts/team:issued/revoke', { method: 'POST', headers: { 'content-type': 'application/json', 'x-priorseal-operator-key': operatorSecret }, body: '{}' });
  assert.equal(revoked.status, 200);
  assert.equal((revoked.json() as unknown as { account: { status: string } }).account.status, 'revoked');
  const rejectedSelf = await request(server, '/v1/agent-accounts/self', { headers: { 'x-priorseal-agent-key': credential } });
  assert.equal(rejectedSelf.status, 403);
});
test('x402 Monad mainnet is advertised, verified, and settled through the HTTP lifecycle', async (t) => {
  const originalFetch = globalThis.fetch;
  const facilitatorCalls: string[] = [];
  globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit) => {
    const url = input instanceof URL ? input : new URL(typeof input === 'string' ? input : input.url);
    facilitatorCalls.push(`${init?.method} ${url.pathname}`);
    if (url.pathname === '/supported') return new Response(JSON.stringify({ kinds: [{ x402Version: 2, scheme: 'exact', network: 'eip155:143' }, { x402Version: 2, scheme: 'exact', network: 'eip155:8453' }] }), { status: 200, headers: { 'content-type': 'application/json' } });
    const body = JSON.parse(String(init?.body)) as { paymentRequirements: { network: string; asset: string; extra: { name: string; version: string } } };
    assert.equal(body.paymentRequirements.network, 'eip155:143');
    assert.equal(body.paymentRequirements.asset, '0x754704Bc059F8C67012fEd69BC8A327a5aafb603');
    assert.deepEqual(body.paymentRequirements.extra, { name: 'USDC', version: '2' });
    if (url.pathname === '/verify') return new Response(JSON.stringify({ isValid: true }), { status: 200, headers: { 'content-type': 'application/json' } });
    if (url.pathname === '/settle') return new Response(JSON.stringify({ success: true, network: 'eip155:143', transaction: `0x${'1'.repeat(64)}`, payer: `0x${'c'.repeat(40)}`, amount: '10000' }), { status: 200, headers: { 'content-type': 'application/json' } });
    throw new Error(`Unexpected facilitator request: ${url.pathname}`);
  }) as typeof fetch;
  t.after(() => { globalThis.fetch = originalFetch; });
  const x402 = parseX402Config({
    PRIORSEAL_X402_FACILITATOR_URL: 'https://monad-facilitator.test',
    PRIORSEAL_X402_RESOURCE_ORIGIN: 'https://api.example.test',
    PRIORSEAL_X402_PAY_TO: `0x${'b'.repeat(40)}`,
    PRIORSEAL_X402_NETWORKS: 'eip155:143',
    PRIORSEAL_X402_ROUTES_JSON: JSON.stringify([{ method: 'GET', path: '/v1/capabilities', description: 'Read deployment capabilities', price: '$0.01' }]),
  });
  assert.ok(x402);
  const server = createHttpServer({ x402 });
  t.after(() => server.close());

  const unpaid = await request(server, '/v1/capabilities');
  assert.equal(unpaid.status, 402);
  assert.equal(unpaid.headers['cache-control'], 'no-store');
  const challenge = unpaid.json() as unknown as { accepts: { network: string; amount: string; asset: string; extra: { name: string; version: string } }[] };
  assert.deepEqual(challenge.accepts.map(requirement => requirement.network), ['eip155:143']);
  const accepted = challenge.accepts[0];
  assert.equal(accepted.amount, '10000');
  assert.equal(accepted.asset, '0x754704Bc059F8C67012fEd69BC8A327a5aafb603');
  assert.deepEqual(accepted.extra, { name: 'USDC', version: '2' });

  const paymentHeader = Buffer.from(JSON.stringify({ x402Version: 2, accepted: { ...accepted, scheme: 'exact', payTo: x402.payTo!, maxTimeoutSeconds: 300 }, payload: {} })).toString('base64');
  const paid = await request(server, '/v1/capabilities', { headers: { 'payment-signature': paymentHeader } });
  assert.equal(paid.status, 200);
  assert.equal(paid.headers['cache-control'], 'private, no-store');
  assert.deepEqual(facilitatorCalls, ['GET /supported', 'POST /verify', 'POST /settle']);
  const paymentResponse = JSON.parse(Buffer.from(paid.headers['payment-response'], 'base64').toString('utf8')) as { success: boolean; network: string; transaction: string };
  assert.equal(paymentResponse.success, true);
  assert.equal(paymentResponse.network, 'eip155:143');
  assert.equal(paymentResponse.transaction, `0x${'1'.repeat(64)}`);
  const capabilities = paid.json() as unknown as { payments: { x402: { configured: boolean; networks: { network: string }[] } } };
  assert.equal(capabilities.payments.x402.configured, true);
  assert.ok(capabilities.payments.x402.networks.some(network => network.network === 'eip155:143'));
});
