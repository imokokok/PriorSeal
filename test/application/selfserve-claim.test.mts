import test from 'node:test';
// TypeScript source; the matching .mjs file is generated by npm run core:build.
import assert from 'node:assert/strict';
import { createMemoryStore } from '../../src/index.mjs';
import { createRpcClient } from '../../src/infrastructure/blockchain/evm/rpc-client.mjs';
import { createSelfserveClaim, selfserveClaimMessage, type SelfserveClaimConfig } from '../../src/application/commerce/selfserve-claim.mjs';
import { privateKeyToAccount } from 'viem/accounts';

const PAY_TO = '0x5fbbbcbf2ade44f5c604e5e55f11945e1addd231';
const USDC = '0x833589fcd6edb6e08f4c7c32d4f71b54bda02913';
const PAYER_KEY = '0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d';
const OTHER_KEY = '0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80';
const BLOCK_HASH = `0x${'1'.repeat(64)}`;

const payer = privateKeyToAccount(PAYER_KEY);
const other = privateKeyToAccount(OTHER_KEY);
const payerAccountId = `selfserve-${payer.address.toLowerCase().slice(2, 10)}`;

function claimConfig(): SelfserveClaimConfig {
  return { schema: 'priorseal.selfserve-claim.v1', chainId: 8453, payTo: PAY_TO, usdcAddress: USDC, minRawUnits: 1_000_000n, rawUnitsPerCredit: 10_000n, credentialKeyHex: 'ab'.repeat(32) };
}

type FakeTransfer = { from: string; to: string; input: string; status: string };

function fakeRpcClient(chain: Map<string, FakeTransfer>) {
  const respond = (result: unknown) => new Response(JSON.stringify({ jsonrpc: '2.0', id: 1, result }), { status: 200, headers: { 'content-type': 'application/json' } });
  const fetchImpl = (async (_url: unknown, init?: { body?: string }) => {
    const { method, params } = JSON.parse(init?.body ?? '{}') as { method: string; params: string[] };
    const entry = chain.get(params[0]);
    if (method === 'eth_getTransactionByHash') {
      return respond(entry ? { hash: params[0], nonce: '0x0', from: entry.from, to: entry.to, value: '0x0', input: entry.input, gasPrice: '0x1', blockNumber: '0x1', blockHash: BLOCK_HASH } : null);
    }
    if (method === 'eth_getTransactionReceipt') {
      return respond(entry ? { status: entry.status, blockNumber: '0x2', gasUsed: '0x5208', blockHash: BLOCK_HASH, transactionHash: params[0], logs: [] } : null);
    }
    return respond(null);
  }) as typeof fetch;
  return createRpcClient({ fetchImpl, retries: 0 });
}

function transferInput(recipient: string, amountRaw: bigint): string {
  return `0xa9059cbb${'0'.repeat(24)}${recipient.slice(2).toLowerCase()}${amountRaw.toString(16).padStart(64, '0')}`;
}

async function claimService(chain: Map<string, FakeTransfer>) {
  return createSelfserveClaim(claimConfig(), { store: createMemoryStore(), rpc: fakeRpcClient(chain), rpcUrls: () => ['https://base-rpc.test'] });
}

function fund(chain: Map<string, FakeTransfer>, txHash: string, from: string, recipient: string, amountRaw: bigint, status = '0x1', to = USDC, input?: string) {
  chain.set(txHash, { from: from.toLowerCase(), to: to.toLowerCase(), input: input ?? transferInput(recipient, amountRaw), status });
}

const sign = (account: ReturnType<typeof privateKeyToAccount>, txHash: string) => account.signMessage({ message: selfserveClaimMessage(PAY_TO, txHash) });

test('selfserve claim message commits to the deployment payTo and transaction hash in lowercase', () => {
  assert.equal(selfserveClaimMessage('0x5FBBbcBF2ade44F5C604e5E55F11945E1adDd231', '0x' + 'A'.repeat(64)), `priorseal-selfserve-claim-v1:${PAY_TO}:0x${'a'.repeat(64)}`);
});

test('a funded transfer claim creates a payment-backed account and returns its credential once', async () => {
  const chain = new Map<string, FakeTransfer>();
  fund(chain, `0x${'a'.repeat(64)}`, payer.address, PAY_TO, 1_500_000n);
  const claim = await claimService(chain);
  const result = await claim.claim({ txHash: `0x${'A'.repeat(64)}`, signature: await sign(payer, `0x${'a'.repeat(64)}`) });
  assert.equal(result.status, 'created');
  assert.equal(result.replay, false);
  assert.equal(result.accountId, payerAccountId);
  assert.equal(result.credits, '150');
  assert.match(result.credential, /^psa_[A-Za-z0-9_-]{43}$/);
  assert.equal(result.account.provisionedCredits, '150');
  assert.equal(result.account.remainingCredits, '150');
  assert.equal(result.account.status, 'active');
});

test('a second funded transfer credits the same account and keeps the credential stable', async () => {
  const chain = new Map<string, FakeTransfer>();
  fund(chain, `0x${'a'.repeat(64)}`, payer.address, PAY_TO, 1_500_000n);
  fund(chain, `0x${'b'.repeat(64)}`, payer.address, PAY_TO, 2_000_000n);
  const claim = await claimService(chain);
  const first = await claim.claim({ txHash: `0x${'a'.repeat(64)}`, signature: await sign(payer, `0x${'a'.repeat(64)}`) });
  const second = await claim.claim({ txHash: `0x${'b'.repeat(64)}`, signature: await sign(payer, `0x${'b'.repeat(64)}`) });
  assert.equal(second.status, 'credited');
  assert.equal(second.credential, first.credential);
  assert.equal(second.account.remainingCredits, '350');
});

test('replaying the same transfer is idempotent and does not double credit', async () => {
  const chain = new Map<string, FakeTransfer>();
  fund(chain, `0x${'a'.repeat(64)}`, payer.address, PAY_TO, 1_500_000n);
  const claim = await claimService(chain);
  const first = await claim.claim({ txHash: `0x${'a'.repeat(64)}`, signature: await sign(payer, `0x${'a'.repeat(64)}`) });
  const replay = await claim.claim({ txHash: `0x${'a'.repeat(64)}`, signature: await sign(payer, `0x${'a'.repeat(64)}`) });
  assert.equal(replay.status, 'credited');
  assert.equal(replay.replay, true);
  assert.equal(replay.credential, first.credential);
  assert.equal(replay.account.remainingCredits, '150');
});

test('a signature from a wallet that did not send the transfer is rejected', async () => {
  const chain = new Map<string, FakeTransfer>();
  fund(chain, `0x${'a'.repeat(64)}`, payer.address, PAY_TO, 1_500_000n);
  const claim = await claimService(chain);
  await assert.rejects(claim.claim({ txHash: `0x${'a'.repeat(64)}`, signature: await sign(other, `0x${'a'.repeat(64)}`) }), (error: { code: string }) => error.code === 'CLAIM_TX_SENDER_MISMATCH');
});

test('a signature that does not verify is rejected', async () => {
  const chain = new Map<string, FakeTransfer>();
  fund(chain, `0x${'a'.repeat(64)}`, payer.address, PAY_TO, 1_500_000n);
  const claim = await claimService(chain);
  const signature = await sign(payer, `0x${'a'.repeat(64)}`);
  const corrupted = `0x${signature.slice(2, -2)}ff` as `0x${string}`;
  await assert.rejects(claim.claim({ txHash: `0x${'a'.repeat(64)}`, signature: corrupted }), (error: { code: string }) => error.code === 'CLAIM_SIGNATURE_INVALID');
});

test('unknown transactions and failed receipts are rejected', async () => {
  const chain = new Map<string, FakeTransfer>();
  fund(chain, `0x${'a'.repeat(64)}`, payer.address, PAY_TO, 1_500_000n, '0x0');
  const claim = await claimService(chain);
  await assert.rejects(claim.claim({ txHash: `0x${'f'.repeat(64)}`, signature: await sign(payer, `0x${'f'.repeat(64)}`) }), (error: { code: string }) => error.code === 'CLAIM_TX_NOT_FOUND');
  await assert.rejects(claim.claim({ txHash: `0x${'a'.repeat(64)}`, signature: await sign(payer, `0x${'a'.repeat(64)}`) }), (error: { code: string }) => error.code === 'CLAIM_TX_FAILED');
});

test('transfers below the minimum, to other recipients, or not transfer calls are rejected', async () => {
  const chain = new Map<string, FakeTransfer>();
  fund(chain, `0x${'a'.repeat(64)}`, payer.address, PAY_TO, 20_000n);
  fund(chain, `0x${'b'.repeat(64)}`, payer.address, `0x${'c'.repeat(40)}`, 1_500_000n);
  fund(chain, `0x${'d'.repeat(64)}`, payer.address, PAY_TO, 1_500_000n, '0x1', USDC, `0x36958cb7${'ab'.repeat(64)}`);
  const claim = await claimService(chain);
  await assert.rejects(claim.claim({ txHash: `0x${'a'.repeat(64)}`, signature: await sign(payer, `0x${'a'.repeat(64)}`) }), (error: { code: string }) => error.code === 'CLAIM_BELOW_MINIMUM');
  await assert.rejects(claim.claim({ txHash: `0x${'b'.repeat(64)}`, signature: await sign(payer, `0x${'b'.repeat(64)}`) }), (error: { code: string }) => error.code === 'CLAIM_TX_NOT_ACCEPTED');
  await assert.rejects(claim.claim({ txHash: `0x${'d'.repeat(64)}`, signature: await sign(payer, `0x${'d'.repeat(64)}`) }), (error: { code: string }) => error.code === 'CLAIM_TX_NOT_ACCEPTED');
});

test('claims against operator-provisioned or revoked accounts are rejected', async () => {
  const chain = new Map<string, FakeTransfer>();
  fund(chain, `0x${'a'.repeat(64)}`, payer.address, PAY_TO, 1_500_000n);
  fund(chain, `0x${'b'.repeat(64)}`, other.address, PAY_TO, 1_500_000n);
  const store = createMemoryStore();
  await store.createAgentMeterAccount({ accountId: payerAccountId, credentialHash: 'cd'.repeat(32), provisionedCredits: '5', status: 'active' });
  const claim = createSelfserveClaim(claimConfig(), { store, rpc: fakeRpcClient(chain), rpcUrls: () => ['https://base-rpc.test'] });
  await assert.rejects(claim.claim({ txHash: `0x${'a'.repeat(64)}`, signature: await sign(payer, `0x${'a'.repeat(64)}`) }), (error: { code: string }) => error.code === 'CLAIM_ACCOUNT_PREEXISTING');
  const otherClaim = await claim.claim({ txHash: `0x${'b'.repeat(64)}`, signature: await sign(other, `0x${'b'.repeat(64)}`) });
  assert.equal(otherClaim.status, 'created');
  await store.revokeAgentMeterAccount(otherClaim.accountId);
  fund(chain, `0x${'c'.repeat(64)}`, other.address, PAY_TO, 1_500_000n);
  await assert.rejects(claim.claim({ txHash: `0x${'c'.repeat(64)}`, signature: await sign(other, `0x${'c'.repeat(64)}`) }), (error: { code: string }) => error.code === 'CLAIM_ACCOUNT_REVOKED');
});

test('malformed hashes and signatures are rejected before any chain read', async () => {
  const chain = new Map<string, FakeTransfer>();
  const claim = await claimService(chain);
  await assert.rejects(claim.claim({ txHash: 'not-a-hash', signature: `0x${'ab'.repeat(65)}` }), (error: { code: string }) => error.code === 'CLAIM_INVALID_REQUEST');
  await assert.rejects(claim.claim({ txHash: `0x${'a'.repeat(64)}`, signature: '0x1234' }), (error: { code: string }) => error.code === 'CLAIM_INVALID_REQUEST');
});
