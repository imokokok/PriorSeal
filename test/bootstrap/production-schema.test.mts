import test from 'node:test';
// TypeScript source; the matching .mjs file is generated by npm run core:build.
import assert from 'node:assert/strict';
import { assertProductionSchema, assertWitnessSchema, REQUIRED_AGENT_METER_CREDIT_OPERATIONS_MIGRATION, REQUIRED_AGENT_METER_MIGRATION, REQUIRED_OBSERVATION_JOB_COALESCING_MIGRATION, REQUIRED_PRODUCTION_MIGRATION, REQUIRED_WITNESS_MIGRATION, REQUIRED_X402_PAYMENT_LEDGER_MIGRATION } from '../../src/bootstrap/production-schema.mjs';

type ProductionDatabase = Parameters<typeof assertProductionSchema>[0];
type WitnessDatabase = Parameters<typeof assertWitnessSchema>[0];

function database({ migration = true, coalescingMigration = true, resultColumn = true, leaseColumns = true, coalesceColumn = true, archive = false, ledger = false, agentMeter = false, agentCreditOperations = false } = {}): ProductionDatabase {
  return {
    async query(sql: string, parameters: unknown[]) {
      if (sql.startsWith('SELECT name FROM schema_migrations')) return { rows: migration ? [{ name: REQUIRED_PRODUCTION_MIGRATION }, ...(coalescingMigration ? [{ name: REQUIRED_OBSERVATION_JOB_COALESCING_MIGRATION }] : []), ...(archive ? [{ name: '009_project_evidence_archive.sql' }] : []), ...(ledger ? [{ name: REQUIRED_X402_PAYMENT_LEDGER_MIGRATION }] : []), ...(agentMeter ? [{ name: REQUIRED_AGENT_METER_MIGRATION }] : []), ...(agentCreditOperations ? [{ name: REQUIRED_AGENT_METER_CREDIT_OPERATIONS_MIGRATION }] : [])] : [{ name: '006_rfc3161_timestamp.sql' }] };
      if (sql.includes('information_schema.tables')) {
        const tables = parameters[0] as string[];
        return { rowCount: tables.length, rows: tables.map((table_name) => ({ table_name })) };
      }
      if (sql.includes('information_schema.columns')) return { rows: [{ table_name: 'authorizations', column_name: 'timestamp_evidence_json' }, ...(resultColumn ? [{ table_name: 'observation_jobs', column_name: 'result_json' }] : []), ...(leaseColumns ? [{ table_name: 'observation_jobs', column_name: 'lease_token' }, { table_name: 'observation_jobs', column_name: 'lease_expires_at' }] : []), ...(coalesceColumn ? [{ table_name: 'observation_jobs', column_name: 'coalesce_key' }] : [])] };
      throw new Error(`Unexpected query: ${sql}`);
    },
  } as unknown as ProductionDatabase;
}

test('production schema requires the Merkle index migration and durable observation columns', async () => {
  await assert.rejects(() => assertProductionSchema(database({ migration: false }), { preExecutionProofMode: 'rfc3161' }), /010_authorization_merkle_index/);
  await assert.rejects(() => assertProductionSchema(database({ coalescingMigration: false }), { preExecutionProofMode: 'rfc3161' }), /017_observation_job_coalescing/);
  await assert.rejects(() => assertProductionSchema(database({ resultColumn: false }), { preExecutionProofMode: 'rfc3161' }), /Durable observation result column/);
  await assert.rejects(() => assertProductionSchema(database({ leaseColumns: false }), { preExecutionProofMode: 'rfc3161' }), /lease columns/);
  await assert.rejects(() => assertProductionSchema(database({ coalesceColumn: false }), { preExecutionProofMode: 'rfc3161' }), /coalescing column/);
  const ready = await assertProductionSchema(database(), { preExecutionProofMode: 'rfc3161' });
  assert.equal(ready.migration, REQUIRED_PRODUCTION_MIGRATION);
  assert.deepEqual(ready.requiredTables, ['authorization_log', 'authorization_log_merkle_nodes', 'authorizations', 'observation_jobs']);
});

test('enabling the project archive requires its recorded migration and scoped table', async () => {
  await assert.rejects(assertProductionSchema(database(), { preExecutionProofMode: 'rfc3161', archiveEnabled: true }), /009_project_evidence_archive/);
  const ready = await assertProductionSchema(database({ archive: true }), { preExecutionProofMode: 'rfc3161', archiveEnabled: true });
  assert.equal(ready.requiredTables.at(-1), 'project_evidence_archive');
});

test('enabling x402 requires its durable payment ledger migration and table', async () => {
  await assert.rejects(assertProductionSchema(database(), { preExecutionProofMode: 'rfc3161', x402Enabled: true }), /012_x402_payment_ledger/);
  const ready = await assertProductionSchema(database({ ledger: true }), { preExecutionProofMode: 'rfc3161', x402Enabled: true });
  assert.equal(ready.requiredTables.at(-1), 'x402_payment_ledger_events');
});

test('enabling Agent prepaid credits requires both durable account and credit-operation migrations', async () => {
  await assert.rejects(assertProductionSchema(database(), { preExecutionProofMode: 'rfc3161', agentMeterEnabled: true }), /013_agent_meter/);
  await assert.rejects(assertProductionSchema(database({ agentMeter: true }), { preExecutionProofMode: 'rfc3161', agentMeterEnabled: true }), /014_agent_meter_credit_operations/);
  const ready = await assertProductionSchema(database({ agentMeter: true, agentCreditOperations: true }), { preExecutionProofMode: 'rfc3161', agentMeterEnabled: true });
  assert.deepEqual(ready.requiredTables.slice(-3), ['agent_meter_accounts', 'agent_meter_usage', 'agent_meter_credit_operations']);
});

test('production schema requires the witness table in witness-quorum mode', async () => {
  const ready = await assertProductionSchema(database(), { preExecutionProofMode: 'witness-quorum' });
  assert.equal(ready.requiredTables.at(-1), 'witness_attestations');
});

test('standalone witness startup requires its recorded migration and table', async () => {
  const calls: string[] = [];
  const witnessDatabase = {
    async query(sql: string) {
      calls.push(sql);
      if (sql.startsWith('SELECT name FROM schema_migrations')) return { rows: [{ name: REQUIRED_WITNESS_MIGRATION }] };
      if (sql.startsWith('SELECT 1 FROM witness_attestations')) return { rows: [] };
      throw new Error(`Unexpected query: ${sql}`);
    },
  } as unknown as WitnessDatabase;
  assert.deepEqual(await assertWitnessSchema(witnessDatabase), { migration: REQUIRED_WITNESS_MIGRATION, table: 'witness_attestations' });
  await assert.rejects(() => assertWitnessSchema({ query: async () => ({ rows: [] }) } as unknown as WitnessDatabase), /005_witness_quorum/);
  assert.equal(calls.at(-1), 'SELECT 1 FROM witness_attestations LIMIT 0');
});
